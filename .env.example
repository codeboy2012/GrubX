# GrubX environment template.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed. Every variable below is read by real code — this
# template contains no speculative or unused settings.
#
# Full reference, including how to obtain each value and how to troubleshoot it:
# docs/ENVIRONMENT.md

# ---------------------------------------------------------------------------
# 1. Application settings
# ---------------------------------------------------------------------------
# Public origin of this deployment. Used for absolute links and provider
# redirect URIs. Optional; defaults to the request origin at runtime.
FRONTEND_URL=https://grub.sky0cloud.dpdns.org
NEXT_PUBLIC_APP_URL=https://grub.sky0cloud.dpdns.org

# ---------------------------------------------------------------------------
# 2. Movie and TV metadata (TMDB) — required for Movies, TV, and Search
# ---------------------------------------------------------------------------
# Base URL of a TMDB-compatible API. TMDB's own host is https://api.themoviedb.org/3
TMDB_PROXY_BASE=https://mtd.sky0cloud.dpdns.org
# TMDB API key. SERVER-SIDE ONLY: it is read exclusively by server code and is
# never sent to the browser. Obtain it at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Legacy names still honoured for existing deployments. Both are browser-visible
# by convention, so prefer the two variables above and rotate any value that was
# previously stored here.
# NEXT_PUBLIC_TMDB_PROXY_BASE=
# NEXT_PUBLIC_TMDB_API_KEY=

# ---------------------------------------------------------------------------
# 3. Anime catalogue (Ani.pm) — no key required
# ---------------------------------------------------------------------------
# Ani.pm's public catalogue and standard embeds need no API key. Only set this
# if you route catalogue calls through your own proxy or mirror.
# NEXT_PUBLIC_ANIME_API_BASE=https://ani.pm/api/partner/v1

# ---------------------------------------------------------------------------
# 4. Anime and movie/TV embed providers
# ---------------------------------------------------------------------------
# VidKing embed base. Optional; defaults to https://www.vidking.net/embed
# NEXT_PUBLIC_VIDKING_BASE=https://www.vidking.net/embed

# ---------------------------------------------------------------------------
# 5. Manga provider (MangaDex) — no key required
# ---------------------------------------------------------------------------
# MangaDex's public read API needs no credential. Set this only to use a
# compatible mirror. The reader never serves explicit-rated content.
# NEXT_PUBLIC_MANGA_API_BASE=https://api.mangadex.org

# ---------------------------------------------------------------------------
# 6. Live TV / live sports
# ---------------------------------------------------------------------------
# GrubX's live guide uses the public sources already wired into
# app/api/live/*; no credential is required or supported.

# ---------------------------------------------------------------------------
# 7. Native apps (Expo) - public, bundle-time setting for native/
# ---------------------------------------------------------------------------
# The Expo app in native/ reads this at bundle time to find the GrubX API.
# ORIGIN ONLY (no trailing /api); see native/src/lib/api.ts. EAS profiles in
# native/eas.json set their own value at build time.
EXPO_PUBLIC_API_BASE=https://grub.sky0cloud.dpdns.org

# ---------------------------------------------------------------------------
# 8. Admin alerts (optional, server-side only)
# ---------------------------------------------------------------------------
# Matrix/Hookshot webhook used by feedback and provider-report routes. Never
# expose this to the browser. Leave blank to disable alerting.
MATRIX_HOOKSHOT_WEBHOOK_URL=
