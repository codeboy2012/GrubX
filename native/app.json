{
  "expo": {
    "name": "GrubX",
    "slug": "grubx",
    "version": "1.0.0",
    "scheme": "grubx",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.grubx.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.grubx.app",
      "adaptiveIcon": {
        "backgroundColor": "#030304",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://grub.sky0cloud.dpdns.org"
        }
      ],
      "./plugins/withGrubxTv.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#030304",
          "dark": {
            "backgroundColor": "#030304"
          }
        }
      ]
    ]
  }
}
